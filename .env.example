# App
PORT=3000

# PostgreSQL & Redis — use localhost when running the API on the host (npm run start:dev)
# with Postgres/Redis on the host or published ports.
# When the API runs in Docker Compose, docker-compose.yml sets DB_HOST=postgres and
# REDIS_HOST=redis for the api service; copy this file to .env for AWS and throttle vars.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=docprocessing
REDIS_HOST=localhost
REDIS_PORT=6379

# Rate limit (global): max requests per TTL window per IP (compose defaults: 10000 / 60s)
# Lower for normal dev; raise temporarily for k6 load tests against the same IP.
# THROTTLE_LIMIT=10
# THROTTLE_TTL_MS=60000

# AWS — required for job uploads; same values for local and Docker (passed through compose)
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Leave empty for real AWS; set for MinIO / LocalStack / custom S3-compatible endpoints
# AWS_S3_ENDPOINT=http://localhost:9000